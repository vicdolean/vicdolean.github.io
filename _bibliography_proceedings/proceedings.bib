  booktitle   = {Domain decomposition methods in science and engineering XX},
  pages       = {271--278},
  publisher   = {Springer},
  series      = {LNCSE},
  title       = {Comparison of a one and two parameter family of transmission conditions for Maxwell's equations with damping},
  volume      = {91},
  year        = {2013}
}

